# Supabase PostgreSQL Configuration
# Copy this file to .env or set environment variables before running the backend:

# 1. Using Supabase Direct Connection (Default Port 5432):
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# 2. Or using Supabase Connection Pooler (Port 6543 / Session or Transaction mode):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Secret Key (min 256 bits)
JWT_SECRET=mlrit_secret_key_super_secure_enterprise_grade_2026_mlr_institute_of_technology
